CAPI=2:

name : local:safety_riscv:dcls_response_error_monitor_tb:0.1
description : Unit test for external DCLS response-error monitor

filesets:
  rtl:
    files:
      - ../safety/dcls_response_error_monitor.v
    file_type : verilogSource

  tb:
    files:
      - ../../tb/dcls_response_error_monitor_tb.sv
    file_type : systemVerilogSource

targets:
  sim:
    default_tool : verilator
    filesets : [rtl, tb]
    toplevel : dcls_response_error_monitor_tb
    tools:
      verilator:
        mode : binary
        verilator_options:
          - "--timing"
          - "-Wno-TIMESCALEMOD"
