CAPI=2:

name : local:safety_riscv:dcls_comparator_tb:0.1
description : Standalone DCLS transaction comparator unit test

filesets:
  rtl:
    files:
      - ../safety/dcls_comparator.v
    file_type : verilogSource

  tb:
    files:
      - ../../tb/dcls_comparator_tb.sv
    file_type : systemVerilogSource

targets:
  sim:
    default_tool : verilator
    filesets : [rtl, tb]
    toplevel : dcls_comparator_tb
    tools:
      verilator:
        mode : binary
        verilator_options:
          - "--timing"
          - "-Wno-TIMESCALEMOD"
