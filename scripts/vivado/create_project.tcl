# ------------------------------------------------------------------------------
# Safety-Oriented RISC-V SoC - Vivado project generator
#
# Usage (Vivado Tcl Console):
#   source E:/Dissertation/Working_Model_RISCV/scripts/vivado/create_project.tcl
#
# Creates  build/vivado/safety_riscv_soc.xpr  from the sources in this
# repository. The project is a generated artefact: it references the sources
# in place (nothing is copied) and can be deleted and regenerated at any time.
#
# Languages: design RTL under rtl/ is Verilog. Ibex under ip/ibex is
# third-party SystemVerilog. Testbenches under tb/ are SystemVerilog.
# ------------------------------------------------------------------------------

set script_dir [file dirname [file normalize [info script]]]
set root       [file normalize [file join $script_dir .. ..]]
set proj_name  safety_riscv_soc
set proj_dir   [file join $root build vivado]
set gen_dir    [file join $root build generated]
set part       xc7a100tcsg324-1
set fpga_top   safety_riscv_soc_arty_a7

puts "INFO: repository root = $root"

# Regenerating while the project is open: close it first.
catch {close_sim -force -quiet}
if {[llength [get_projects -quiet]] > 0} {
    close_project
}

# ------------------------------------------------------------------------------
# 1. Generated header with absolute firmware image paths
# ------------------------------------------------------------------------------
set demo_fw [file join $root fw images stage5_battery_monitor_demo.vmem]
if {![file exists $demo_fw]} {
    error "Demo firmware image not found: $demo_fw\nBuild it first in WSL: bash /mnt/e/Dissertation/Working_Model_RISCV/fw/build_demo.sh"
}
file mkdir $gen_dir
set fh [open [file join $gen_dir fw_images.vh] w]
puts $fh "// Generated by scripts/vivado/create_project.tcl - do not edit."
puts $fh "`ifndef FW_IMAGES_VH"
puts $fh "`define FW_IMAGES_VH"
foreach f [lsort [glob -directory [file join $root fw images] *.vmem]] {
    set macro [string toupper [file rootname [file tail $f]]]
    puts $fh "`define FW_${macro} \"$f\""
}
puts $fh "`endif"
close $fh

# ------------------------------------------------------------------------------
# 2. Project
# ------------------------------------------------------------------------------
create_project $proj_name $proj_dir -part $part -force
set_property target_language    Verilog [current_project]
set_property simulator_language Mixed   [current_project]
# Compile order is exactly the order in which files are added below.
set_property source_mgmt_mode   None    [current_project]

# ------------------------------------------------------------------------------
# 3. Design sources
# ------------------------------------------------------------------------------
set ibex_root  [file join $root ip ibex]
set ibex_files [list]
set fl [open [file join $ibex_root filelist.f] r]
while {[gets $fl line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string index $line 0] eq "#"} { continue }
    lappend ibex_files [file join $ibex_root $line]
}
close $fl

set design_files [list \
    [file join $root rtl safety dcls_comparator.v] \
    [file join $root rtl safety dcls_paired_data_capture_stage.v] \
    [file join $root rtl safety dcls_response_error_monitor.v] \
    [file join $root rtl safety dcls_fault_injector.v] \
    [file join $root rtl safety core_response_fault_injector.v] \
    [file join $root rtl safety safety_fault_manager_stage4f.v] \
    [file join $root rtl safety safety_mmio_config_stage4f.v] \
    [file join $root rtl safety safety_execution_supervisor.v] \
    [file join $root rtl safety safety_diagnostic_logger.v] \
    [file join $root rtl soc safety_riscv_soc_stage1_mmio.v] \
    [file join $root rtl soc safety_riscv_soc_stage4f.v] \
    [file join $root rtl board arty_a7_clock_gen.v] \
    [file join $root rtl board uart_tx.v] \
    [file join $root rtl board board_input_debounce.v] \
    [file join $root rtl board demo_fault_injection_ctrl.v] \
    [file join $root rtl board demo_status_reporter.v] \
    [file join $root rtl board safety_riscv_soc_arty_a7.v] \
]

foreach f [concat $ibex_files $design_files] {
    if {![file exists $f]} { error "Missing source file: $f" }
}

add_files -norecurse -fileset sources_1 $ibex_files
add_files -norecurse -fileset sources_1 $design_files

set inc_dirs [list \
    $gen_dir \
    [file join $ibex_root lowrisc_dv_dv_fcov_macros_0] \
    [file join $ibex_root lowrisc_prim_assert_0.1 rtl] \
    [file join $ibex_root lowrisc_prim_secded_0.1 rtl] \
    [file join $ibex_root lowrisc_prim_util_get_scramble_params_0 rtl] \
    [file join $ibex_root lowrisc_prim_util_memload_0 rtl] \
    [file join $ibex_root lowrisc_prim_fifo_0 rtl] \
]

set_property include_dirs   $inc_dirs       [get_filesets sources_1]
set_property verilog_define {FPGA_XILINX=1} [get_filesets sources_1]
set_property top            $fpga_top       [get_filesets sources_1]

# ------------------------------------------------------------------------------
# 4. Constraints
# ------------------------------------------------------------------------------
add_files -norecurse -fileset constrs_1 [list \
    [file join $root constraints arty_a7_100t_pins.xdc] \
    [file join $root constraints clock.xdc] \
]

# ------------------------------------------------------------------------------
# 5. Simulation sets: one per test, selectable in the GUI
#    (Sources window > Simulation Sources > right-click > Make Active)
# ------------------------------------------------------------------------------
# SystemVerilog assertion files (tb/sva). Each file holds one checker module
# and the 'bind' statement that attaches it to a Verilog design module, so
# the assertions are active in every simulation without editing the design.
set sva_dir [file join $root tb sva]
set sva_all [list \
    [file join $sva_dir sva_fault_manager.sv] \
    [file join $sva_dir sva_execution_supervisor.sv] \
    [file join $sva_dir sva_mmio_config.sv] \
    [file join $sva_dir sva_diagnostic_logger.sv] \
    [file join $sva_dir sva_soc_safety.sv] \
]
foreach f $sva_all {
    if {![file exists $f]} { error "Missing assertion file: $f" }
}

proc add_simset {name top tb_files unit_srcs plusarg} {
    global inc_dirs sva_dir sva_all
    if {[llength [get_filesets -quiet $name]] == 0} {
        create_fileset -simset $name
    }
    set fs [get_filesets $name]
    if {[llength $unit_srcs] > 0} {
        # Unit test: compile only the module under test, not the whole SoC.
        if {[catch {set_property source_set {} $fs} msg]} {
            puts "WARNING: $name keeps the full design as source set: $msg"
        }
        add_files -norecurse -fileset $fs $unit_srcs
        # Attach the assertions that exist for the module under test.
        foreach src $unit_srcs {
            set m [file rootname [file tail $src]]
            regsub {^safety_} $m {} short
            set sva [file join $sva_dir "sva_${short}.sv"]
            if {[file exists $sva]} {
                add_files -norecurse -fileset $fs $sva
            }
        }
    } else {
        set_property source_set sources_1 $fs
        # Full design: all assertions are active.
        add_files -norecurse -fileset $fs $sva_all
    }
    add_files -norecurse -fileset $fs $tb_files
    set_property include_dirs   $inc_dirs $fs
    set_property verilog_define {FPGA_XILINX=1 DISABLE_PRIM_CDC_RAND_DELAY} $fs
    set_property top            $top $fs
    set_property top_lib        xil_defaultlib $fs
    set_property -name {xsim.simulate.runtime}         -value {all}  -objects $fs
    set_property -name {xsim.simulate.log_all_signals} -value {true} -objects $fs
    if {$plusarg ne ""} {
        set_property -name {xsim.simulate.xsim.more_options} \
            -value "-testplusarg $plusarg" -objects $fs
    }
}

set tb_unit [file join $root tb unit]
set tb_soc  [file join $root tb soc]
set rtl_s   [file join $root rtl safety]

# --- Unit tests -----------------------------------------------------------
foreach m {dcls_comparator dcls_fault_injector core_response_fault_injector \
           dcls_response_error_monitor safety_execution_supervisor \
           dcls_paired_data_capture_stage safety_diagnostic_logger} {
    add_simset "unit_${m}" "${m}_tb" \
        [list [file join $tb_unit "${m}_tb.sv"]] \
        [list [file join $rtl_s "${m}.v"]] ""
}

# --- UVM environment for the central safety manager ------------------------
# Fault manager + execution supervisor + diagnostic logger, driven by a UVM
# environment with a reference-model scoreboard and functional coverage.
# The UVM library shipped with Vivado is selected with -L uvm.
set tb_uvm [file join $root tb uvm]
add_simset uvm_safety_manager safety_manager_uvm_tb \
    [list [file join $tb_uvm safety_manager_if.sv] \
          [file join $tb_uvm safety_manager_pkg.sv] \
          [file join $tb_uvm safety_manager_uvm_tb.sv] \
          [file join $sva_dir sva_fault_manager.sv]] \
    [list [file join $rtl_s safety_execution_supervisor.v] \
          [file join $rtl_s safety_fault_manager_stage4f.v] \
          [file join $rtl_s safety_diagnostic_logger.v]] ""

# Checker sensitivity (mutation) runs: the same environment with one
# deliberate design error each. A run passes only if the scoreboard
# detects the error.
foreach m {1 2 3} {
    add_simset "uvm_mutation_${m}" safety_manager_uvm_tb \
        [list [file join $tb_uvm safety_manager_if.sv] \
              [file join $tb_uvm safety_manager_pkg.sv] \
              [file join $tb_uvm safety_manager_uvm_tb.sv]] \
        [list [file join $rtl_s safety_execution_supervisor.v] \
              [file join $rtl_s safety_fault_manager_stage4f.v] \
              [file join $rtl_s safety_diagnostic_logger.v]] \
        "UVM_TESTNAME=safety_manager_mutation_test -testplusarg MUTATION=${m}"
}

foreach fs [get_filesets uvm_*] {
    set_property -name {xsim.compile.xvlog.more_options} -value {-L uvm} -objects $fs
    set_property -name {xsim.elaborate.xelab.more_options} -value {-L uvm} -objects $fs
}

# --- SoC tests: safety mechanisms (one testbench, one scenario per set) ----
set tb4f [list [file join $tb_soc safety_riscv_soc_stage4f_tb.sv]]
add_simset soc_safety_heartbeat safety_riscv_soc_stage4f_tb $tb4f {} ""
foreach {setname plusarg} {
    soc_safety_data_request_stability   ibex_data_stability_test
    soc_safety_data_response_fault      dcls_core_b_data_response_fault_test
    soc_safety_data_error_mismatch      dcls_data_response_error_integration_test
    soc_safety_instr_error_mismatch     dcls_response_error_integration_test
    soc_safety_double_fault_capture     ibex_double_fault_test
    soc_safety_mmio_replica_integrity   mmio_replica_integrity_test
    soc_safety_config_integrity         profile_integrity_test
    soc_safety_profile_policy           profile_policy_test
    soc_safety_ram_address_guard        address_guard_test
    soc_safety_store_inhibit            dcls_store_inhibit_test
    soc_safety_instr_address_guard      instruction_guard_test
    soc_safety_supervisor_ram_contain   supervisor_ram_containment_test
    soc_safety_supervisor_mmio_contain  supervisor_mmio_containment_test
    soc_safety_heartbeat_loss           supervisor_timeout_test
} {
    add_simset $setname safety_riscv_soc_stage4f_tb $tb4f {} $plusarg
}

# --- SoC tests: native Ibex double fault and firmware ----------------------
add_simset soc_native_double_fault safety_riscv_soc_stage4f_native_double_fault_tb \
    [list [file join $tb_soc safety_riscv_soc_stage4f_native_double_fault_tb.sv]] {} ""
add_simset soc_fw_smoke   safety_riscv_soc_stage5_tb \
    [list [file join $tb_soc safety_riscv_soc_stage5_tb.sv]] {} ""
add_simset soc_fw_hal     safety_riscv_soc_stage5_hal_tb \
    [list [file join $tb_soc safety_riscv_soc_stage5_hal_tb.sv]] {} ""
add_simset soc_fw_battery safety_riscv_soc_stage5_battery_tb \
    [list [file join $tb_soc safety_riscv_soc_stage5_battery_tb.sv]] {} ""

# --- Same workload in Basic, Safety and Diagnostic: execution-time cost ----
add_simset soc_profile_performance safety_riscv_soc_profile_perf_tb \
    [list [file join $tb_soc safety_riscv_soc_profile_perf_tb.sv]] {} ""

# --- Board-level demonstration: switches, button, LEDs and UART ------------
add_simset board_demo safety_riscv_soc_arty_a7_tb \
    [list [file join $root tb board safety_riscv_soc_arty_a7_tb.sv]] {} ""

# The battery-monitor run is the default active simulation.
current_fileset -simset [get_filesets soc_fw_battery]
catch {delete_fileset sim_1}

# -----------------------------------------------------------------------------
# Implementation strategy
#
# The longest path (instruction decode -> ALU -> branch -> cross-core
# comparison -> data grant, 32 logic levels) uses almost the whole 20 ns
# period, so the default strategy closes timing only by a small margin and
# not on every placement. This strategy adds physical optimisation before
# and after routing.
# -----------------------------------------------------------------------------
set_property strategy Performance_ExplorePostRoutePhysOpt [get_runs impl_1]

puts ""
puts "=============================================================="
puts " Project created: [file join $proj_dir ${proj_name}.xpr]"
puts " FPGA top       : $fpga_top ($part)"
puts " Simulation sets: [llength [get_filesets -filter {FILESET_TYPE == SimulationSrcs}]]"
puts " Next           : source [file join $script_dir run_regression.tcl]"
puts "=============================================================="
